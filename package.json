{
  "name": "affilio",
  "version": "0.1.0",
  "private": true,
  "description": "AFFILIO \u2014 AI-Powered Affiliate Content Operating System. Create Once. Distribute Everywhere. Optimize Everything.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @affilio/web dev",
    "dev:api": "pnpm --filter @affilio/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:migrate": "pnpm --filter @affilio/api migrate",
    "db:seed": "pnpm --filter @affilio/api seed",
    "dev:worker": "pnpm --filter @affilio/api worker",
    "media:scan": "pnpm --filter @affilio/api scan",
    "db:backup": "./scripts/db-backup.sh",
    "dev:publisher": "pnpm --filter @affilio/api publisher"
  },
  "devDependencies": {
    "@affilio/config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10"
  }
}
