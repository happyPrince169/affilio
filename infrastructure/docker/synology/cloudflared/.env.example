# AFFILIO Cloudflare Tunnel connector — copy to `.env` next to docker-compose.yml ON THE NAS
# (never on the laptop, never committed; `.env` is git-ignored and protected from nas:sync).
# Set the file to mode 600. The token comes from Cloudflare Zero Trust → Networks → Tunnels →
# affilio-nas → "Install and run a connector" (the value after `--token`).
TUNNEL_TOKEN=
CLOUDFLARED_MEMORY=128M
