# ===================================================================================
# AFFILIO — Synology production environment (copy to .env next to docker-compose.yml)
# Every value is an example. Generate real secrets; never commit the resulting .env.
# ===================================================================================

# --- Host paths (DSM shared folders). Adjust volume number and folder names. ----------
# Originals and proxies are mounted READ-ONLY. AFFILIO never writes there.
AFFILIO_ORIGINALS_HOST_PATH=/volume1/video/originals
AFFILIO_PROXIES_HOST_PATH=/volume1/video/proxies
# Finished videos uploaded by editors. Read-only; indexed separately from originals.
AFFILIO_FINALS_HOST_PATH=/volume1/video/finals
# Read-write locations owned by AFFILIO. Create them first (see docs/deployment/synology.md).
AFFILIO_THUMBNAILS_HOST_PATH=/volume1/docker/affilio/thumbnails
AFFILIO_EXPORTS_HOST_PATH=/volume1/docker/affilio/exports
AFFILIO_DATA_HOST_PATH=/volume1/docker/affilio/data

# --- Process identity (must be able to read originals/proxies, write thumbnails/exports) --
AFFILIO_UID=1026
AFFILIO_GID=100

# --- Network -----------------------------------------------------------------------
# LAN IP of the NAS. Use 0.0.0.0 only if the NAS firewall restricts the port to the LAN.
AFFILIO_BIND_ADDRESS=192.168.1.10
AFFILIO_WEB_PORT=3080
CORS_ORIGINS=

# --- Secrets (generate: openssl rand -hex 32) -----------------------------------------
POSTGRES_PASSWORD=change-me-postgres
# Service token for CLI/cron calls against the API (scan triggers). Browsers use sessions.
MEDIA_ADMIN_TOKEN=change-me-admin-token

# --- Authentication (M3A) -----------------------------------------------------------------
# Plain HTTP on the LAN: set to false so the session cookie is accepted. Behind TLS leave empty.
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=14
PUBLICATION_MIN_GAP_MINUTES=30

# --- Meta / Facebook Page connection (M3B.1A) -----------------------------------------------
# Production runs the live provider only (mock is refused when APP_ENV=production).
# Fill these from the Meta App Dashboard (docs/integrations/meta-app-setup.md). Until then the
# accounts page explains which names are missing and "Connect Facebook Page" stays disabled.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
# https, byte-identical to the app's "Valid OAuth Redirect URIs"; terminates on the DSM proxy.
META_OAUTH_REDIRECT_URI=
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
META_LOGIN_CONFIG_ID=
# Credential vault key ring (`key_id:base64`, generate with `openssl rand -base64 32`).
# Back it up OUTSIDE the database backups; without it stored tokens are unreadable and every
# Page must be reconnected (docs/architecture/security.md#credential-vault).
CREDENTIAL_ENCRYPTION_KEYS=
CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=
SESSION_RETENTION_DAYS=30
OAUTH_STATE_RETENTION_HOURS=24
# Reels publishing engine (M3B.2A). Keep live publishing OFF until the activation checklist
# (docs/integrations/meta-live-publishing-activation.md) has been completed.
META_LIVE_PUBLISHING_ENABLED=false
PUBLISHER_MAX_CONCURRENT_UPLOADS=1
PUBLISHER_POLL_INTERVAL_SECONDS=5
PUBLISHER_UPLOAD_CHUNK_BYTES=4194304
PUBLISHER_LEASE_SECONDS=120
PUBLISHER_MAX_RETRIES=5
# Schedules missed while the stack was down: released within the grace window, otherwise held
# for an operator ("review") or released anyway ("publish"). Decisions are audited.
PUBLISHER_OVERDUE_GRACE_MINUTES=120
PUBLISHER_OVERDUE_POLICY=review

# --- Database ------------------------------------------------------------------------
POSTGRES_USER=affilio
POSTGRES_DB=affilio

# --- Application -----------------------------------------------------------------------
DEFAULT_ORGANIZATION_SLUG=demo-org
DOCS_ENABLED=false
LOG_LEVEL=INFO

# --- Media indexing ----------------------------------------------------------------------
# Proxy filename candidates, same relative directory under the proxies root.
MEDIA_PROXY_PATTERNS={stem}.mp4,{stem}_proxy.mp4,{name}.mp4,{stem}.mov
MEDIA_VIDEO_EXTENSIONS=.mp4,.mov,.m4v,.mkv,.avi,.mts,.m2ts,.webm,.mxf,.3gp
MEDIA_THUMBNAIL_CONCURRENCY=1
MEDIA_THUMBNAIL_WIDTH=640
MEDIA_PROBE_TIMEOUT_SECONDS=60
# A final video is indexed only once its mtime is older than this (upload settled).
MEDIA_FINAL_SETTLE_SECONDS=120
MEDIA_THUMBNAIL_TIMEOUT_SECONDS=120
WORKER_POLL_INTERVAL_SECONDS=5

# --- Resource limits (tune to the NAS: these suit a 4-core / 8 GB model) -------------------
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=512M
API_CPUS=1.0
API_MEMORY=512M
WORKER_CPUS=2.0
WORKER_MEMORY=768M
PUBLISHER_CPUS=0.5
PUBLISHER_MEMORY=256M
WEB_CPUS=1.0
WEB_MEMORY=384M
UVICORN_WORKERS=1

# --- Images (set to a registry tag when not building on the NAS) ---------------------------
AFFILIO_API_IMAGE=affilio-api:latest
AFFILIO_WEB_IMAGE=affilio-web:latest
