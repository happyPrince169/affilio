# ============================================================================
# AFFILIO — local environment template
# Copy to `.env` (git-ignored). Never commit real credentials, tokens or keys.
# Every value below is a LOCAL DEVELOPMENT default, not a production secret.
# ============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development              # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console               # console (dev) | json (prod / CI)
DOCS_ENABLED=true                # Swagger UI at http://localhost:8000/docs

# --- HTTP --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL (docker-compose) --------------------------------------------
POSTGRES_USER=affilio
POSTGRES_PASSWORD=affilio
POSTGRES_DB=affilio
POSTGRES_TEST_DB=affilio_test
POSTGRES_PORT=5440               # host port; 5432 is often occupied by a system PostgreSQL

# --- API database connections ------------------------------------------------
DATABASE_URL=postgresql+psycopg://affilio:affilio@localhost:5440/affilio
TEST_DATABASE_URL=postgresql+psycopg://affilio:affilio@localhost:5440/affilio_test

# --- Web (browser-visible; inlined at build time) ---------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Reserved for later milestones (leave unset in M0) -----------------------
# ANTHROPIC_API_KEY=              # M5 — Claude agent. Never commit.
# NAS_MEDIA_ROOT=                 # M1 — Synology share mount path on the API host.
# REDIS_URL=                      # Only if a background-processing need is confirmed.
