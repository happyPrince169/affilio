# ============================================================================
# AFFILIO — local environment template
# Copy to `.env` (git-ignored). Never commit real credentials, tokens or keys.
# Every value below is a LOCAL DEVELOPMENT default, not a production secret.
# ============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development              # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console               # console (dev) | json (prod / CI)
DOCS_ENABLED=true                # Swagger UI at http://localhost:8000/docs

# --- HTTP --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL (docker-compose) --------------------------------------------
POSTGRES_USER=affilio
POSTGRES_PASSWORD=affilio
POSTGRES_DB=affilio
POSTGRES_TEST_DB=affilio_test
POSTGRES_PORT=5440               # host port; 5432 is often occupied by a system PostgreSQL

# --- API database connections ------------------------------------------------
DATABASE_URL=postgresql+psycopg://affilio:affilio@localhost:5440/affilio
TEST_DATABASE_URL=postgresql+psycopg://affilio:affilio@localhost:5440/affilio_test

# --- Web (browser-visible; inlined at build time) ---------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Media library (M1) ------------------------------------------------------
# Logical media roots. On the workstation point them at a local folder or a mounted
# NAS share. In the Synology compose file these are fixed container paths; host paths
# are configured there instead. Leave unset to run without a media library.
MEDIA_ORIGINALS_PATH=            # read-only source videos, e.g. /mnt/nas/video/originals
MEDIA_PROXIES_PATH=              # read-only HEVC proxies, e.g. /mnt/nas/video/proxies
MEDIA_FINALS_PATH=               # read-only finished videos from editors, e.g. /mnt/nas/video/finals
MEDIA_FINAL_SETTLE_SECONDS=120   # finals younger than this are treated as still uploading
MEDIA_THUMBNAILS_PATH=           # read-write, e.g. ./var/thumbnails
MEDIA_EXPORTS_PATH=              # read-write, e.g. ./var/exports
# Proxy filename candidates relative to the same directory under the proxies root.
MEDIA_PROXY_PATTERNS={stem}.mp4,{stem}_proxy.mp4,{name}.mp4,{stem}.mov
MEDIA_THUMBNAIL_CONCURRENCY=1
# Service token for CLI/cron calls (scans, release-due). Never used by browsers; optional.
MEDIA_ADMIN_TOKEN=
# Organization a service-token call acts on when X-Organization-Slug is not sent.
DEFAULT_ORGANIZATION_SLUG=demo-org

# --- Authentication (M3A) -----------------------------------------------------
# Session cookie: HttpOnly, SameSite=Lax; Secure outside development unless overridden.
SESSION_COOKIE_NAME=affilio_session
SESSION_TTL_DAYS=14
# SESSION_COOKIE_SECURE=false     # only for plain-HTTP LAN deployments; leave unset otherwise
# Failed sign-in attempts per IP / per email in the window before /auth/login answers 429.
AUTH_LOGIN_MAX_ATTEMPTS_PER_MINUTE=10
AUTH_LOGIN_WINDOW_SECONDS=60
# Use X-Forwarded-For as the client IP for rate limiting. Only behind the web proxy (compose
# sets it); leave false when the API is reachable directly.
TRUST_PROXY_HEADERS=false
# Development seed credentials (seed_dev refuses to run outside development/test).
SEED_ADMIN_EMAIL=owner@affilio.local
SEED_ADMIN_PASSWORD=affilio-dev-owner
# Minimum minutes between two publications scheduled for the same account.
PUBLICATION_MIN_GAP_MINUTES=30

# --- Meta / Facebook Page connection (M3B.1A) -------------------------------------
# live  → real Graph API (needs META_APP_ID/SECRET/REDIRECT_URI); mock → deterministic in-process
# provider for development and tests. mock is refused when APP_ENV is staging/production.
META_PROVIDER_MODE=mock
META_APP_ID=                      # from the Meta App Dashboard (live mode only)
META_APP_SECRET=                  # never commit; live mode only
META_GRAPH_API_VERSION=v26.0
# Browser-facing callback, byte-identical to the app's "Valid OAuth Redirect URIs" (https).
# Mock mode works without it (the callback is relative to the API origin).
META_OAUTH_REDIRECT_URI=
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
META_LOGIN_CONFIG_ID=             # only for Facebook Login for Business configurations
META_OAUTH_STATE_TTL_SECONDS=600
# Where the OAuth callback sends the browser afterwards. Leave empty behind the same-origin
# web proxy; set to the web origin when the API runs on another host/port (split dev setup).
WEB_BASE_URL=http://localhost:3000

# --- Credential vault (M3B.1A) ---------------------------------------------------------
# Key ring for AES-256-GCM encryption of provider tokens: `key_id:base64(32 bytes)`, comma
# separated. Generate: `openssl rand -base64 32`. Without a key the connection endpoints
# answer 503 and store nothing. Back the key up separately from the database.
CREDENTIAL_ENCRYPTION_KEYS=
# Required when more than one key is listed (rotation). Defaults to the only key otherwise.
CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=

# --- Reels publishing engine (M3B.2A) --------------------------------------------------
# Live publishing stays OFF until the Meta app exists and the activation checklist is done;
# with mock Pages the publisher simulates the whole lifecycle.
META_LIVE_PUBLISHING_ENABLED=false
META_REELS_DAILY_QUOTA=30
PUBLISHER_POLL_INTERVAL_SECONDS=5
PUBLISHER_MAX_CONCURRENT_UPLOADS=2
PUBLISHER_LEASE_SECONDS=120
PUBLISHER_UPLOAD_CHUNK_BYTES=4194304
PUBLISHER_MAX_RETRIES=5
PUBLISHER_BACKOFF_BASE_SECONDS=30
PUBLISHER_BACKOFF_MAX_SECONDS=900
PUBLISHER_STATUS_POLL_SECONDS=15
PUBLISHER_PUBLISH_TIMEOUT_MINUTES=30
# Missed schedules (downtime): within the grace window → released after revalidation;
# beyond it → "review" holds them for an operator's Release, "publish" releases anyway.
PUBLISHER_OVERDUE_GRACE_MINUTES=120
PUBLISHER_OVERDUE_POLICY=review

# --- Maintenance (M3B.1A; worker runs it every MAINTENANCE_INTERVAL_SECONDS) -----------
SESSION_RETENTION_DAYS=30
OAUTH_STATE_RETENTION_HOURS=24
MAINTENANCE_INTERVAL_SECONDS=3600

# --- Web server-side (NOT NEXT_PUBLIC; only used by the /api proxy route) ---------
API_INTERNAL_URL=http://localhost:8000

# --- Reserved for later milestones -------------------------------------------
# ANTHROPIC_API_KEY=              # M5 — Claude agent. Never commit.
# REDIS_URL=                      # Only if a background-processing need is confirmed.
